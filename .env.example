# FIPlay local configuration. Copy to .env and fill in; .env is gitignored.
# Bun loads .env automatically for every `bun run` / `bun <script>`.
# Never put passwords here: `bun run nas:setup-ssh` prompts for the NAS password.

# --- Required for `bun run deploy`, `bun run backend`, `bun run nas:*` ---------
# ssh host of the NAS (hostname, IP, or a Host alias from ~/.ssh/config)
FIPLAY_NAS_HOST=
# ssh user on the NAS
FIPLAY_NAS_USER=
# directory on the NAS that its web server serves, e.g. /path/to/web/FIPlay
FIPLAY_NAS_WEB_DIR=
# public URL of that directory, with trailing slash, e.g. http://my-nas/FIPlay/
FIPLAY_NAS_WEB_URL=
# Now-playing metadata service, no trailing slash. Leave empty to use the public
# one at https://fip-metadata.fly.dev; set it to your own copy to avoid its cold
# starts and to cover stations the public one does not know.
VITE_METADATA_URL=

# PyRaumfeld API root, with trailing slash, e.g. http://my-nas:8081/
# Passed to the app as ?backend=… ; optional for `bun browse` (browser player only)
FIPLAY_BACKEND_URL=

# --- Optional: HTTPS on the NAS (`bun run nas:https`) ---------------------------
# A phone only installs a web app, rather than bookmarking it, when the site is
# served over HTTPS. And an HTTPS page may not call an http:// address, so the
# speaker API has to answer on the app's own origin. `bun run nas:https` sets up
# both: a TLS virtual host, and a proxy that puts the API on the path below.
#
# Hostname the phone will use, which must match the certificate, e.g. nas.example.org
FIPLAY_NAS_HTTPS_HOST=
# Path the API is proxied on. Set this and `bun run deploy` points the installed
# app at it, instead of the absolute URL above which https would block.
FIPLAY_BACKEND_PATH=/pyraumfeld/
# Port for the TLS virtual host (default 4433)
#FIPLAY_NAS_HTTPS_PORT=4433
# Certificate on the NAS; the key may be in the same file (default shown)
#FIPLAY_NAS_CERT=/etc/stunnel/stunnel.pem
# Intermediate chain, skipped when the file is absent (default shown)
#FIPLAY_NAS_CERT_CHAIN=/etc/stunnel/uca.pem

# --- Optional: PyRaumfeld container on the NAS (defaults shown) ----------------
#FIPLAY_BACKEND_PORT=8081
#FIPLAY_BACKEND_IMAGE=ghcr.io/culmat/pyraumfeld:master
#FIPLAY_BACKEND_CONTAINER=pyraumfeld
# docker binary on the NAS when it is not on the non-interactive PATH
# (auto-detected for QNAP Container Station when unset)
#FIPLAY_NAS_DOCKER=

# --- Optional: `bun browse` ------------------------------------------------------
# The browser itself comes from Playwright (bunx playwright install chromium).
#BROWSER_CDP_PORT=9222
#BROWSER_PROFILE_DIR=.browser-profile
# first tab to open; default is the dev server plus ?backend=FIPLAY_BACKEND_URL
#BROWSER_URL=

# --- Optional: run your own metadata service ------------------------------------
# The service is a container; point VITE_METADATA_URL above at it, e.g.
#   docker run -d --name fip-metadata --restart unless-stopped -p 8082:8080 <image>
